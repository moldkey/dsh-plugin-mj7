{
  "name": "@liangjiehappy/dsh-plugin-mj7",
  "version": "0.1.8",
  "description": "模极社 mj7.cn 只读数据工具：标准/产品搜索、HS 联想、Incoterms、贸易单证、人民币汇率。只访问 www.mj7.cn。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "permissions": [
      "network"
    ]
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mj7",
    "standards",
    "manufacturing",
    "trade"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moldkey/dsh-plugin-mj7.git"
  },
  "homepage": "https://github.com/moldkey/dsh-plugin-mj7",
  "bugs": {
    "url": "https://github.com/moldkey/dsh-plugin-mj7/issues"
  }
}
